KEYCLOAK_CLIENT_ID="access-management"
KEYCLOAK_CLIENT_SECRET="your-client-secret"
KEYCLOAK_ISSUER="http://localhost:8080/realms/your-realm"
NEXTAUTH_URL="http://localhost:3000/api/auth"
NEXTAUTH_URL_INTERNAL='http://localhost:3000'
NEXTAUTH_SECRET="your-nextauth-secret"

NEXT_PUBLIC_BASE_PATH=""

IGRP_APP_MANAGER_API="https://api-gateway.nosi.cv/access-manager"
IGRP_APP_CODE="demo"
IGRP_PREVIEW_MODE="false"
IGRP_APP_NAME_DESCRIPTION="YOUR APP DESCRIPTION NAME"

IGRP_APP_CENTER_URL="http://localhost:3000/app-center"

IGRP_APP_HOME_SLUG=""

API_GATEWAY="http://localhost:8085"
# System Administration endpoints used by SDK route control.
# A relative NEXT_PUBLIC_API_URL must include the API prefix, normally /api/v1.
NEXT_PUBLIC_API_URL=/api/v1
API_URL=
SYSTEM_ADMIN_API_URL=
IRN_API_BACKOFFICE_BASE_URL=

# APISIX JWT signing.
JWT_KEY=
# Local and Kubernetes: PEM content (PKCS#8 or PKCS#1); escaped \n is supported.
JWT_PRIVATE_KEY=
# IRN production/Vault: path to the mounted private-key file. Leave
# JWT_PRIVATE_KEY unset when this mode is used.
Authentication__JwtPrivateKey=

# Optional external login renderer and opt-in redacted SDK diagnostics.
AUTH_LOGIN_PATH_URL=
IRN_EXPERIENCE_SDK_DEBUG=false
